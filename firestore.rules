rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives & Identity Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.matches('(?i)^azadisocialwelfareorganization@gmail\\.com$')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // 1. Settings Validation Block
    function isValidSettings(data) {
      return data.keys().hasAll(['nameBn', 'nameEn', 'phone', 'email'])
        && data.nameBn is string && data.nameBn.size() <= 300
        && data.nameEn is string && data.nameEn.size() <= 300
        && data.phone is string && data.phone.size() <= 50
        && data.email is string && data.email.size() <= 100
        && (!data.keys().hasAny(['organizationNameBn']) || (data.organizationNameBn is string && data.organizationNameBn.size() <= 300))
        && (!data.keys().hasAny(['organizationNameEn']) || (data.organizationNameEn is string && data.organizationNameEn.size() <= 300))
        && (!data.keys().hasAny(['sloganBn']) || (data.sloganBn is string && data.sloganBn.size() <= 500))
        && (!data.keys().hasAny(['sloganEn']) || (data.sloganEn is string && data.sloganEn.size() <= 500))
        && (!data.keys().hasAny(['addressBn']) || (data.addressBn is string && data.addressBn.size() <= 1000))
        && (!data.keys().hasAny(['addressEn']) || (data.addressEn is string && data.addressEn.size() <= 1000))
        && (!data.keys().hasAny(['establishedBn']) || (data.establishedBn is string && data.establishedBn.size() <= 100))
        && (!data.keys().hasAny(['establishedEn']) || (data.establishedEn is string && data.establishedEn.size() <= 100))
        && (!data.keys().hasAny(['logo']) || data.logo is string)
        && (!data.keys().hasAny(['flag']) || data.flag is string)
        && (!data.keys().hasAny(['flagUrl']) || data.flagUrl is string)
        && (!data.keys().hasAny(['logoUrl']) || data.logoUrl is string)
        && (!data.keys().hasAny(['faviconUrl']) || data.faviconUrl is string)
        && (!data.keys().hasAny(['website']) || data.website is string)
        && (!data.keys().hasAny(['primaryColor']) || (data.primaryColor is string && data.primaryColor.size() <= 50))
        && (!data.keys().hasAny(['secondaryColor']) || (data.secondaryColor is string && data.secondaryColor.size() <= 50))
        && (!data.keys().hasAny(['adminWhatsApp']) || (data.adminWhatsApp is string && data.adminWhatsApp.size() <= 50))
        && (!data.keys().hasAny(['whatsapp']) || (data.whatsapp is string && data.whatsapp.size() <= 50))
        && (!data.keys().hasAny(['bkash']) || (data.bkash is string && data.bkash.size() <= 50))
        && (!data.keys().hasAny(['nagad']) || (data.nagad is string && data.nagad.size() <= 50))
        && (!data.keys().hasAny(['roket']) || (data.roket is string && data.roket.size() <= 50))
        && (!data.keys().hasAny(['facebook']) || data.facebook is string)
        && (!data.keys().hasAny(['youtube']) || data.youtube is string)
        && (!data.keys().hasAny(['whatsappChannel']) || data.whatsappChannel is string)
        && (!data.keys().hasAny(['googleChatSpace']) || (data.googleChatSpace is string && data.googleChatSpace.size() <= 500))
        && (!data.keys().hasAny(['googleChatEnabled']) || data.googleChatEnabled is bool)
        && (!data.keys().hasAny(['googleChatNotifyOnReceipt']) || data.googleChatNotifyOnReceipt is bool)
        && (!data.keys().hasAny(['googleChatNotifyOnApproval']) || data.googleChatNotifyOnApproval is bool)
        && (!data.keys().hasAny(['googleChatNotifyOnExpense']) || data.googleChatNotifyOnExpense is bool)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string);
    }

    function isValidLetterhead(data) {
      return data.keys().hasAll(['leaderName', 'designation', 'signature', 'stampText', 'bodyText'])
        && data.leaderName is string && data.leaderName.size() <= 200
        && data.designation is string && data.designation.size() <= 200
        && data.signature is string
        && data.stampText is string && data.stampText.size() <= 200
        && data.bodyText is string && data.bodyText.size() <= 50000
        && (!data.keys().hasAny(['organizationNameBn']) || (data.organizationNameBn is string && data.organizationNameBn.size() <= 300))
        && (!data.keys().hasAny(['organizationNameEn']) || (data.organizationNameEn is string && data.organizationNameEn.size() <= 300))
        && (!data.keys().hasAny(['addressBn']) || (data.addressBn is string && data.addressBn.size() <= 1000))
        && (!data.keys().hasAny(['addressEn']) || (data.addressEn is string && data.addressEn.size() <= 1000))
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 50))
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 100))
        && (!data.keys().hasAny(['website']) || data.website is string)
        && (!data.keys().hasAny(['logoUrl']) || data.logoUrl is string)
        && (!data.keys().hasAny(['signatureUrl']) || data.signatureUrl is string)
        && (!data.keys().hasAny(['footerBn']) || (data.footerBn is string && data.footerBn.size() <= 1000))
        && (!data.keys().hasAny(['footerEn']) || (data.footerEn is string && data.footerEn.size() <= 1000))
        && (!data.keys().hasAny(['signatureWidth']) || data.signatureWidth is number)
        && (!data.keys().hasAny(['signatureYOffset']) || data.signatureYOffset is number)
        && (!data.keys().hasAny(['signatureXOffset']) || data.signatureXOffset is number)
        && (!data.keys().hasAny(['signatureRotation']) || data.signatureRotation is number)
        && (!data.keys().hasAny(['signatureOpacity']) || data.signatureOpacity is number)
        && (!data.keys().hasAny(['qrEnabled']) || data.qrEnabled is bool)
        && (!data.keys().hasAny(['qrSize']) || data.qrSize is number)
        && (!data.keys().hasAny(['qrPosition']) || data.qrPosition is string)
        && (!data.keys().hasAny(['qrCustomText']) || data.qrCustomText is string)
        && (!data.keys().hasAny(['qrXOffset']) || data.qrXOffset is number)
        && (!data.keys().hasAny(['qrYOffset']) || data.qrYOffset is number)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string);
    }

    function isValidVersion(data) {
      return data.keys().hasAll(['latestVersion', 'buildNumber', 'releaseDate', 'releaseNotes', 'forceUpdate'])
        && data.latestVersion is string && data.latestVersion.size() <= 50
        && data.buildNumber is number
        && data.releaseDate is string && data.releaseDate.size() <= 100
        && data.releaseNotes is string && data.releaseNotes.size() <= 10000
        && data.forceUpdate is bool
        && (!data.keys().hasAny(['version']) || (data.version is string && data.version.size() <= 50))
        && (!data.keys().hasAny(['build']) || data.build is number)
        && (!data.keys().hasAny(['apkDownloadUrl']) || data.apkDownloadUrl is string)
        && (!data.keys().hasAny(['updateSize']) || data.updateSize is string)
        && (!data.keys().hasAny(['playStoreUrl']) || data.playStoreUrl is string)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string);
    }

    match /settings/config {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(incoming());
    }

    match /settings/letterhead {
      allow read: if true;
      allow write: if isAdmin() && isValidLetterhead(incoming());
    }

    match /settings/version {
      allow read: if true;
      allow write: if isAdmin() && isValidVersion(incoming());
    }

    // 2. Admins Collection
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'active'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && (data.role == 'superadmin' || data.role == 'admin' || data.role == 'editor')
        && data.active is bool
        && (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 200))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (adminId == request.auth.uid || isAdmin());
      allow write: if (
        (isAdmin() && isValidAdmin(incoming()) && adminId == incoming().uid) ||
        (isSignedIn() && request.auth.uid == adminId && request.auth.token.email.matches('(?i)^azadisocialwelfareorganization@gmail\\.com$') && isValidAdmin(incoming()))
      );
    }

    // 3. Donations Collection (Public document strictly excludes sensitive PII)
    function isValidPublicDonation(data) {
      return data.keys().hasAll(['id', 'amount', 'purpose', 'date'])
        && data.id is string && data.id.size() <= 128
        && data.amount is number && data.amount > 0 && data.amount < 100000000
        && data.purpose is string && data.purpose.size() <= 200
        && data.date is string && data.date.size() <= 50
        && (!data.keys().hasAny(['donorName']) || (data.donorName is string && data.donorName.size() <= 200))
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 200))
        && (!data.keys().hasAny(['isAnonymous']) || data.isAnonymous is bool)
        && (!data.keys().hasAny(['anonymous']) || data.anonymous is bool)
        && (!data.keys().hasAny(['status']) || (data.status is string && (data.status == 'PENDING' || data.status == 'APPROVED' || data.status == 'REJECTED')))
        && (!data.keys().hasAny(['approved']) || data.approved is bool)
        && (!data.keys().hasAny(['currency']) || (data.currency is string && data.currency.size() <= 20))
        && (!data.keys().hasAny(['paymentMethod']) || (data.paymentMethod is string && data.paymentMethod.size() <= 100))
        && (!data.keys().hasAny(['method']) || (data.method is string && data.method.size() <= 100))
        && (!data.keys().hasAny(['receiptId']) || (data.receiptId is string && data.receiptId.size() <= 128))
        && (!data.keys().hasAny(['isPublic']) || data.isPublic is bool)
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100))
        && (!data.keys().hasAny(['phone', 'email', 'transactionId', 'address', 'paymentReference', 'privateNotes']));
    }

    // Private donor information subcollection: donations/{donationId}/private_info/details
    function isValidPrivateInfo(data) {
      return (!data.keys().hasAny(['donorName']) || (data.donorName is string && data.donorName.size() <= 200))
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 50))
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 200))
        && (!data.keys().hasAny(['address']) || (data.address is string && data.address.size() <= 500))
        && (!data.keys().hasAny(['transactionId']) || (data.transactionId is string && data.transactionId.size() <= 128))
        && (!data.keys().hasAny(['paymentReference']) || (data.paymentReference is string && data.paymentReference.size() <= 200))
        && (!data.keys().hasAny(['privateNotes']) || (data.privateNotes is string && data.privateNotes.size() <= 1000))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /donations/{donationId} {
      allow get: if isValidId(donationId);
      allow list: if true;
      allow create: if isValidId(donationId) && donationId == incoming().id && isValidPublicDonation(incoming()) && (isAdmin() || !incoming().keys().hasAny(['status']) || incoming().status == 'PENDING');
      allow update: if isValidId(donationId) && donationId == incoming().id && isAdmin() && isValidPublicDonation(incoming());
      allow delete: if isValidId(donationId) && isAdmin();

      // Private donor information subcollection
      match /private_info/{docId} {
        allow read: if isAdmin();
        allow create: if isValidId(donationId) && (docId == 'details' || isValidId(docId)) && isValidPrivateInfo(incoming());
        allow update, delete: if isAdmin();
      }
    }

    // Collection group rule for admin to query all private_info subcollections securely
    match /{path=**}/private_info/{docId} {
      allow read, write: if isAdmin();
    }

    // 4. Public Aggregate Statistics Collection
    match /public_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Leadership Collection
    function isValidLeader(data) {
      return data.keys().hasAll(['id', 'nameEn', 'nameBn', 'designationEn', 'designationBn', 'image', 'order'])
        && data.id is string && data.id.size() <= 128
        && data.nameEn is string && data.nameEn.size() <= 200
        && data.nameBn is string && data.nameBn.size() <= 200
        && data.designationEn is string && data.designationEn.size() <= 200
        && data.designationBn is string && data.designationBn.size() <= 200
        && data.image is string
        && data.order is number
        && (!data.keys().hasAny(['subDesignationEn']) || (data.subDesignationEn is string && data.subDesignationEn.size() <= 200))
        && (!data.keys().hasAny(['subDesignationBn']) || (data.subDesignationBn is string && data.subDesignationBn.size() <= 200))
        && (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 100))
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 50))
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 200))
        && (!data.keys().hasAny(['bioEn']) || (data.bioEn is string && data.bioEn.size() <= 5000))
        && (!data.keys().hasAny(['bioBn']) || (data.bioBn is string && data.bioBn.size() <= 5000))
        && (!data.keys().hasAny(['quoteEn']) || (data.quoteEn is string && data.quoteEn.size() <= 5000))
        && (!data.keys().hasAny(['quoteBn']) || (data.quoteBn is string && data.quoteBn.size() <= 5000))
        && (!data.keys().hasAny(['messageEn']) || (data.messageEn is string && data.messageEn.size() <= 5000))
        && (!data.keys().hasAny(['messageBn']) || (data.messageBn is string && data.messageBn.size() <= 5000))
        && (!data.keys().hasAny(['sortOrder']) || data.sortOrder is number)
        && (!data.keys().hasAny(['active']) || data.active is bool)
        && (!data.keys().hasAny(['status']) || (data.status == 'active' || data.status == 'inactive'))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /leadership/{leaderId} {
      allow list: if true;
      allow get: if isValidId(leaderId);
      allow create, update: if isValidId(leaderId) && isAdmin() && isValidLeader(incoming());
      allow delete: if isValidId(leaderId) && isAdmin();
    }

    // 6. Events Collection
    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'titleEn', 'titleBn', 'descriptionEn', 'descriptionBn', 'locationEn', 'locationBn', 'date', 'image'])
        && data.id is string && data.id.size() <= 128
        && data.titleEn is string && data.titleEn.size() <= 200
        && data.titleBn is string && data.titleBn.size() <= 200
        && data.descriptionEn is string && data.descriptionEn.size() <= 5000
        && data.descriptionBn is string && data.descriptionBn.size() <= 5000
        && data.locationEn is string && data.locationEn.size() <= 5000
        && data.locationBn is string && data.locationBn.size() <= 5000
        && data.date is string
        && data.image is string
        && (!data.keys().hasAny(['time']) || (data.time is string && data.time.size() <= 50))
        && (!data.keys().hasAny(['meetUrl']) || (data.meetUrl is string && data.meetUrl.size() <= 1000))
        && (!data.keys().hasAny(['status']) || (data.status is string && data.status.size() <= 50))
        && (!data.keys().hasAny(['featured']) || data.featured is bool)
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /events/{eventId} {
      allow list: if true;
      allow get: if isValidId(eventId);
      allow create, update: if isValidId(eventId) && isAdmin() && isValidEvent(incoming());
      allow delete: if isValidId(eventId) && isAdmin();
    }

    // 7. Notices Collection
    function isValidNotice(data) {
      return data.keys().hasAll(['id', 'titleEn', 'titleBn', 'contentEn', 'contentBn', 'date'])
        && data.id is string && data.id.size() <= 128
        && data.titleEn is string && data.titleEn.size() <= 200
        && data.titleBn is string && data.titleBn.size() <= 200
        && data.contentEn is string && data.contentEn.size() <= 10000
        && data.contentBn is string && data.contentBn.size() <= 10000
        && data.date is string
        && (!data.keys().hasAny(['priority']) || (data.priority is string && data.priority.size() <= 50))
        && (!data.keys().hasAny(['isUrgent']) || data.isUrgent is bool)
        && (!data.keys().hasAny(['published']) || data.published is bool)
        && (!data.keys().hasAny(['attachmentUrl']) || data.attachmentUrl is string)
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /notices/{noticeId} {
      allow list: if true;
      allow get: if isValidId(noticeId);
      allow create, update: if isValidId(noticeId) && isAdmin() && isValidNotice(incoming());
      allow delete: if isValidId(noticeId) && isAdmin();
    }

    // 8. News Collection
    function isValidNews(data) {
      return data.keys().hasAll(['id', 'titleEn', 'titleBn', 'contentEn', 'contentBn', 'date', 'image'])
        && data.id is string && data.id.size() <= 128
        && data.titleEn is string && data.titleEn.size() <= 200
        && data.titleBn is string && data.titleBn.size() <= 200
        && data.contentEn is string && data.contentEn.size() <= 10000
        && data.contentBn is string && data.contentBn.size() <= 10000
        && data.date is string
        && data.image is string
        && (!data.keys().hasAny(['author']) || (data.author is string && data.author.size() <= 200))
        && (!data.keys().hasAny(['published']) || data.published is bool)
        && (!data.keys().hasAny(['publishedAt']) || (data.publishedAt is string && data.publishedAt.size() <= 100))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /news/{newsId} {
      allow list: if true;
      allow get: if isValidId(newsId);
      allow create, update: if isValidId(newsId) && isAdmin() && isValidNews(incoming());
      allow delete: if isValidId(newsId) && isAdmin();
    }

    // 9. Audit Logs Collection (Append-only)
    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'action', 'userId', 'userEmail'])
        && data.id is string && data.id.size() <= 128
        && data.action is string && data.action.size() <= 200
        && data.userId is string && data.userId.size() <= 128
        && data.userEmail is string && data.userEmail.size() <= 200
        && (!data.keys().hasAny(['collection']) || (data.collection is string && data.collection.size() <= 100))
        && (!data.keys().hasAny(['targetCollection']) || (data.targetCollection is string && data.targetCollection.size() <= 100))
        && (!data.keys().hasAny(['documentId']) || (data.documentId is string && data.documentId.size() <= 128))
        && (!data.keys().hasAny(['targetDocId']) || (data.targetDocId is string && data.targetDocId.size() <= 128))
        && (!data.keys().hasAny(['timestamp']) || (data.timestamp is string && data.timestamp.size() <= 100))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['details']) || (data.details is string && data.details.size() <= 50000));
    }

    match /audit_logs/{logId} {
      allow list, get: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // 10. Testimonials Collection
    function isValidTestimonial(data) {
      return data.keys().hasAll(['id', 'image', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.image is string
        && data.createdAt is string
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 200))
        && (!data.keys().hasAny(['nameEn']) || (data.nameEn is string && data.nameEn.size() <= 200))
        && (!data.keys().hasAny(['nameBn']) || (data.nameBn is string && data.nameBn.size() <= 200))
        && (!data.keys().hasAny(['designation']) || (data.designation is string && data.designation.size() <= 200))
        && (!data.keys().hasAny(['roleEn']) || (data.roleEn is string && data.roleEn.size() <= 200))
        && (!data.keys().hasAny(['roleBn']) || (data.roleBn is string && data.roleBn.size() <= 200))
        && (!data.keys().hasAny(['locationEn']) || (data.locationEn is string && data.locationEn.size() <= 200))
        && (!data.keys().hasAny(['locationBn']) || (data.locationBn is string && data.locationBn.size() <= 200))
        && (!data.keys().hasAny(['quoteEn']) || (data.quoteEn is string && data.quoteEn.size() <= 5000))
        && (!data.keys().hasAny(['quoteBn']) || (data.quoteBn is string && data.quoteBn.size() <= 5000))
        && (!data.keys().hasAny(['messageEn']) || (data.messageEn is string && data.messageEn.size() <= 5000))
        && (!data.keys().hasAny(['messageBn']) || (data.messageBn is string && data.messageBn.size() <= 5000))
        && (!data.keys().hasAny(['rating']) || (data.rating is number && data.rating >= 1 && data.rating <= 5))
        && (!data.keys().hasAny(['approved']) || data.approved is bool)
        && (!data.keys().hasAny(['status']) || (data.status == 'PENDING' || data.status == 'APPROVED'))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /testimonials/{testimonialId} {
      allow list: if true;
      allow get: if isValidId(testimonialId);
      allow create: if isValidId(testimonialId) && testimonialId == incoming().id && isValidTestimonial(incoming()) && (isAdmin() || !incoming().keys().hasAny(['status']) || incoming().status == 'PENDING');
      allow update: if isValidId(testimonialId) && testimonialId == incoming().id && isAdmin() && isValidTestimonial(incoming());
      allow delete: if isValidId(testimonialId) && isAdmin();
    }

    // 11. Expenses Collection (Admin only)
    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'amount', 'category', 'date'])
        && data.id is string && data.id.size() <= 128
        && data.amount is number && data.amount > 0 && data.amount < 100000000
        && data.category is string && data.category.size() <= 200
        && data.date is string && data.date.size() <= 100
        && (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 500))
        && (!data.keys().hasAny(['currency']) || (data.currency is string && data.currency.size() <= 20))
        && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 5000))
        && (!data.keys().hasAny(['descriptionEn']) || (data.descriptionEn is string && data.descriptionEn.size() <= 5000))
        && (!data.keys().hasAny(['descriptionBn']) || (data.descriptionBn is string && data.descriptionBn.size() <= 5000))
        && (!data.keys().hasAny(['createdBy']) || (data.createdBy is string && data.createdBy.size() <= 200))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /expenses/{expenseId} {
      allow list, get: if isAdmin();
      allow create, update: if isValidId(expenseId) && expenseId == incoming().id && isAdmin() && isValidExpense(incoming());
      allow delete: if isValidId(expenseId) && isAdmin();
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }
  }
}
