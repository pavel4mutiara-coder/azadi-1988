rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Public read access for all images/files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Public user submissions for testimonials photos (image only, under 10MB)
    match /testimonials/{fileName} {
      allow create: if isImage() && isUnder10MB();
      allow update, delete: if isAuthenticated();
    }

    // Authenticated Admin uploads for all standard folders (events, news, leadership, settings, letterhead, etc.)
    match /{folder}/{fileName} {
      allow write, delete: if isAuthenticated();
    }
  }
}
